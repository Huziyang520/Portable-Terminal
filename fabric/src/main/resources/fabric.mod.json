{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "license": "${license}",
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/portable-terminal",
    "issues": "https://github.com/Huziyang520/Portable-Terminal/issues",
    "sources": "https://github.com/Huziyang520/Portable-Terminal"
  },
  "icon": "icon.png",
  "environment": "*",
  "accessWidener": "${mod_id}.accesswidener",
  "entrypoints": {
    "main": [
      "com.portableterminal.fabric.PortableTerminalFabric"
    ],
    "client": [
      "com.portableterminal.fabric.PortableTerminalFabricClient"
    ],
    "modmenu": [
      "com.portableterminal.fabric.PortableTerminalModMenu"
    ],
    "jei_mod_plugin": [
      "com.portableterminal.compat.PortableTerminalJeiPlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${fabric_minecraft_range}",
    "java": ">=${java_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.portableterminal.feedback": "https://github.com/Huziyang520/Portable-Terminal/issues"
      }
    }
  }
}
